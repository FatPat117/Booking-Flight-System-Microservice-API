{
  "name": "booking-flight-system",
  "private": true,
  "workspaces": [
    "api",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks || true",
    "build": "npm run build --workspace=@booking-flight-system/contracts && npm run build --workspace=@booking-flight-system/api && npm run build --workspace=@booking-flight-system/flight-notifier",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:test": "npm run typecheck:test --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "postinstall": "npm run build --workspace=@booking-flight-system/contracts"
  }
}
