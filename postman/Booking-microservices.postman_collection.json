{
  "info": {
    "name": "Booking Microservices (Day 33)",
    "description": "Local API collection for the booking learning project.\n\nProgress covered:\n- Day 9\u201315: flights CRUD, auth, audit, migrations\n- Day 26\u201329: bookings, cancel, correlationId\n- Day 31\u201332: Identity register + JWT login on :3001\n- Day 33: GET /api/whoami verifies JWT on api (:3000); flights still use ADMIN_API_KEY\n\nImport together with Booking-microservices.local.postman_environment.json.\nSet adminApiKey to match your local .env ADMIN_API_KEY.\nidentityBaseUrl defaults to http://localhost:3001. Login first to set accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminApiKey",
      "value": "local-dev-admin-key-2026"
    },
    {
      "key": "flightId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": "investigate-001"
    },
    {
      "key": "identityBaseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Public liveness and readiness checks (Day 11).",
      "item": [
        {
          "name": "GET /live",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}",
                "description": "Optional. Server echoes or generates one."
              }
            ],
            "url": "{{baseUrl}}/live"
          },
          "response": []
        },
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}"
              }
            ],
            "url": "{{baseUrl}}/health"
          },
          "response": []
        },
        {
          "name": "GET /ready",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}"
              }
            ],
            "url": "{{baseUrl}}/ready"
          },
          "response": []
        }
      ]
    },
    {
      "name": "JWT probe (Day 33)",
      "description": "Only route using verifyJwt today. Login via Identity first to set accessToken. Flights still use ADMIN_API_KEY until Day 34.",
      "item": [
        {
          "name": "GET /api/whoami",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/whoami",
            "description": "200 + { userId, email } when Bearer JWT is valid.\n401 MISSING_TOKEN / INVALID_TOKEN / TOKEN_EXPIRED otherwise."
          },
          "response": []
        },
        {
          "name": "GET /api/whoami (missing token \u2192 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/whoami",
            "description": "Expect 401 MISSING_TOKEN."
          },
          "response": []
        },
        {
          "name": "GET /api/whoami (invalid token \u2192 401)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-valid.jwt.token",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/whoami",
            "description": "Expect 401 INVALID_TOKEN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flights (Read)",
      "description": "Public read endpoints. No authentication required.",
      "item": [
        {
          "name": "GET /api/flights",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/flights?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "flights"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Default: 1"
                },
                {
                  "key": "pageSize",
                  "value": "20",
                  "description": "Default: 20, max: 100"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /api/flights/:id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/flights/{{flightId}}",
            "description": "Uses {{flightId}} from a previous create. Run POST /api/flights first or set flightId manually."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flights (Write)",
      "description": "Protected write endpoint (Day 12). Requires Authorization: Bearer {{adminApiKey}}.\nDay 29: x-request-id becomes correlationId on flight.created outbox + flight_created_consumed logs.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminApiKey}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "POST /api/flights",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.id) {",
                  "    pm.collectionVariables.set('flightId', body.id);",
                  "    pm.environment.set('flightId', body.id);",
                  "  }",
                  "}",
                  "const requestId = pm.request.headers.get('x-request-id');",
                  "if (requestId) {",
                  "  console.log('Day 29: grep this correlationId in api + flight-notifier logs \u2192', requestId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-request-id",
                "value": "{{requestId}}",
                "description": "Day 29: becomes correlationId on outbox flight.created (and consumer logs)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"VN888\",\n  \"origin\": \"SGN\",\n  \"destination\": \"HAN\",\n  \"departureAt\": \"2026-12-10T08:00:00+07:00\",\n  \"arrivalAt\": \"2026-12-10T10:00:00+07:00\",\n  \"priceInCents\": 15000000,\n  \"currency\": \"VND\",\n  \"availableSeats\": 5\n}"
            },
            "url": "{{baseUrl}}/api/flights",
            "description": "201 Created + Location header.\nAuth: Authorization Bearer {{adminApiKey}} (NOT x-api-key).\nDay 29: wait ~5s then grep {{requestId}} in flight-notifier for flight_created_consumed."
          },
          "response": []
        },
        {
          "name": "POST /api/flights (duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-request-id",
                "value": "{{requestId}}-duplicate"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"VN888\",\n  \"origin\": \"SGN\",\n  \"destination\": \"HAN\",\n  \"departureAt\": \"2026-12-10T08:00:00+07:00\",\n  \"arrivalAt\": \"2026-12-10T10:00:00+07:00\",\n  \"priceInCents\": 15000000,\n  \"currency\": \"VND\",\n  \"availableSeats\": 5\n}"
            },
            "url": "{{baseUrl}}/api/flights",
            "description": "Run after a successful create with the same payload. Expect 409 FLIGHT_ALREADY_EXISTS."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bookings",
      "description": "Day 26 create booking (public). Day 28 cancel booking. Day 29: x-request-id \u2192 correlationId on booking.created.",
      "item": [
        {
          "name": "POST /api/flights/:flightId/bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.id) {",
                  "    pm.collectionVariables.set('bookingId', body.id);",
                  "    pm.environment.set('bookingId', body.id);",
                  "  }",
                  "}",
                  "const requestId = pm.request.headers.get('x-request-id');",
                  "if (requestId) {",
                  "  console.log('Day 29: grep this correlationId \u2192', requestId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-request-id",
                "value": "{{requestId}}",
                "description": "Day 29: becomes correlationId on booking.created"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerName\": \"Alice Nguyen\"\n}"
            },
            "url": "{{baseUrl}}/api/flights/{{flightId}}/bookings",
            "description": "Public (no admin key).\n201 created | 409 sold-out | 404 flight-not-found | 422 validation.\nSaves {{bookingId}}. Wait ~5s \u2192 booking_created_consumed with same correlationId."
          },
          "response": []
        },
        {
          "name": "DELETE /api/bookings/:id",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "description": "Day 28 cancel.\n204 first cancel | 409 already-cancelled | 404 not-found.\nReleases one seat. Run twice to see 204 then 409."
          },
          "response": []
        },
        {
          "name": "DELETE /api/bookings/:id (already cancelled \u2192 409)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}-cancel-again"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "description": "Run after a successful DELETE. Expect 409 BOOKING_ALREADY_CANCELLED."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Day 29 \u2014 Correlation investigate",
      "description": "Fixed requestId for log grep across api + flight-notifier.",
      "item": [
        {
          "name": "1) Create flight (correlation probe)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const probe = 'investigate-' + Date.now();",
                  "pm.environment.set('requestId', probe);",
                  "pm.collectionVariables.set('requestId', probe);",
                  "console.log('Use this correlationId to grep logs:', probe);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.id) {",
                  "    pm.environment.set('flightId', body.id);",
                  "    pm.collectionVariables.set('flightId', body.id);",
                  "  }",
                  "}",
                  "console.log('grep correlationId in both terminals:', pm.environment.get('requestId'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminApiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-request-id",
                "value": "{{requestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"VN29\",\n  \"origin\": \"SGN\",\n  \"destination\": \"DAD\",\n  \"departureAt\": \"2026-12-20T08:00:00+07:00\",\n  \"arrivalAt\": \"2026-12-20T09:30:00+07:00\",\n  \"priceInCents\": 1200000,\n  \"currency\": \"VND\",\n  \"availableSeats\": 3\n}"
            },
            "url": "{{baseUrl}}/api/flights",
            "description": "Generates a fresh requestId each run.\nThen: open Postman Console for the id, wait ~5s, search flight-notifier log for correlationId."
          },
          "response": []
        },
        {
          "name": "2) Create booking (same correlation probe)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body && body.id) {",
                  "    pm.environment.set('bookingId', body.id);",
                  "    pm.collectionVariables.set('bookingId', body.id);",
                  "  }",
                  "}",
                  "console.log('grep booking correlationId:', pm.request.headers.get('x-request-id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-request-id",
                "value": "{{requestId}}-booking"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerName\": \"Correlation Probe\"\n}"
            },
            "url": "{{baseUrl}}/api/flights/{{flightId}}/bookings",
            "description": "Uses flightId from step 1. Grep {{requestId}}-booking in both logs after ~5s."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Identity (Day 31\u201332)",
      "description": "Identity service on {{identityBaseUrl}} (default :3001). Register + JWT login. api does not verify JWT yet (Day 33).",
      "item": [
        {
          "name": "POST /api/identity/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{identityBaseUrl}}/api/identity/register",
            "description": "201 + { id, email, createdAt } \u2014 never passwordHash.\n409 EMAIL_ALREADY_REGISTERED on duplicate.\n422 validation (email format, password >= 8)."
          },
          "response": []
        },
        {
          "name": "POST /api/identity/register (duplicate \u2192 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{identityBaseUrl}}/api/identity/register",
            "description": "Run after a successful register with the same email. Expect 409."
          },
          "response": []
        },
        {
          "name": "POST /api/identity/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) {",
                  "    pm.environment.set('accessToken', body.accessToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{identityBaseUrl}}/api/identity/login",
            "description": "200 + { accessToken, expiresIn }. Payload is { sub, email } \u2014 readable without JWT_SECRET (signed, not encrypted).\nPaste accessToken into jwt.io to verify.\nSaves accessToken to environment on success."
          },
          "response": []
        },
        {
          "name": "POST /api/identity/login (wrong password \u2192 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{identityBaseUrl}}/api/identity/login",
            "description": "401 INVALID_CREDENTIALS \u2014 same message as unknown email (no user enumeration)."
          },
          "response": []
        },
        {
          "name": "POST /api/identity/login (unknown email \u2192 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{identityBaseUrl}}/api/identity/login",
            "description": "401 INVALID_CREDENTIALS \u2014 identical body to wrong-password case."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Examples (Errors)",
      "description": "Quick manual checks for auth and validation behavior.",
      "item": [
        {
          "name": "POST /api/flights (missing auth \u2192 401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-request-id",
                "value": "{{requestId}}-no-auth"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"VN999\",\n  \"origin\": \"SGN\",\n  \"destination\": \"HAN\",\n  \"departureAt\": \"2026-12-11T08:00:00+07:00\",\n  \"arrivalAt\": \"2026-12-11T10:00:00+07:00\",\n  \"priceInCents\": 15000000,\n  \"currency\": \"VND\",\n  \"availableSeats\": 120\n}"
            },
            "url": "{{baseUrl}}/api/flights"
          },
          "response": []
