            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}-bad-page"
              }
            ],
            "url": "{{baseUrl}}/api/flights?page=0"
          },
          "response": []
        },
        {
          "name": "DELETE /api/bookings/missing \u2192 404",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-request-id",
                "value": "{{requestId}}-missing-booking"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/missing-booking-id"
          },
          "response": []
        }
      ]
    }
  ]
}
