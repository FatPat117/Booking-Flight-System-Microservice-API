            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{identityBaseUrl}}/api/identity/register",
            "description": "201 + { id, email, createdAt } — never passwordHash.\n409 EMAIL_ALREADY_REGISTERED on duplicate.\n422 validation (email format, password >= 8)."
          },
          "response": []
