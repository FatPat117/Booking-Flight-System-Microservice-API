PORT=3000
# Host default when running npm run dev against compose RabbitMQ.
# Inside docker compose, app overrides this to amqp://guest:guest@rabbitmq:5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Identity service (Day 31+) — Postgres
IDENTITY_PORT=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# api (Day 40+) — Postgres, booking_db. Deliberately NOT POSTGRES_USER/
# POSTGRES_PASSWORD above — those are identity's credentials; api connects
# with its own role (docker/postgres-init/01-create-booking-db.sh), so a
# compromised or misused api connection has no path to identity_db.
BOOKING_POSTGRES_USER=
BOOKING_POSTGRES_PASSWORD=

# JWT issued by Identity on login (Day 32). Secret must be ≥ 32 chars.
# Generate: openssl rand -base64 32
# Day 33+: api and identity share the same JWT_SECRET from this root .env.
# Day 34: POST /api/flights requires Bearer JWT with role=admin (no ADMIN_API_KEY).
JWT_SECRET=
JWT_EXPIRES_IN=1h
