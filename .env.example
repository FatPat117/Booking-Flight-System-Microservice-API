PORT=3000
# Host default when running npm run dev against compose RabbitMQ.
# Inside docker compose, app overrides this to amqp://guest:guest@rabbitmq:5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Postgres container bootstrap (Day 42) — read only by docker-compose.yml's
# postgres service and docker/postgres-init/*.sh. NOT read by any
# application. This is the cluster superuser, used solely to create
# identity_db/booking_db and their dedicated, non-superuser roles during
# init — never used for a routine application connection.
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

# Identity service (Day 31+) — Postgres, identity_db. Day 42: renamed from
# POSTGRES_USER/PASSWORD, which happened to collide with the superuser
# bootstrap vars above (same names the Postgres image itself reads) — that
# collision was why identity was unknowingly running as the cluster
# superuser. identity connects with its own role
# (docker/postgres-init/00-create-identity-db.sh).
IDENTITY_PORT=
IDENTITY_POSTGRES_USER=
IDENTITY_POSTGRES_PASSWORD=

# api (Day 40+) — Postgres, booking_db. Its own role
# (docker/postgres-init/01-create-booking-db.sh), so a compromised or
# misused api connection has no path to identity_db.
BOOKING_POSTGRES_USER=
BOOKING_POSTGRES_PASSWORD=

# JWT issued by Identity on login (Day 32). Secret must be ≥ 32 chars.
# Generate: openssl rand -base64 32
# Day 33+: api and identity share the same JWT_SECRET from this root .env.
# Day 34: POST /api/flights requires Bearer JWT with role=admin (no ADMIN_API_KEY).
JWT_SECRET=
JWT_EXPIRES_IN=1h
